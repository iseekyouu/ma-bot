{
  "name": "bybit-ma-bot",
  "version": "1.0.0",
  "description": "Бот для Bybit Spot: держит BTC, пока дневное закрытие выше скользящей средней (MA50)",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts run",
    "once": "bun run src/main.ts once",
    "status": "bun run src/main.ts status",
    "backtest": "bun run src/main.ts backtest",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ccxt": "^4.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
