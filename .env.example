# Скопируйте в .env и заполните. Бот читает .env из папки проекта, откуда бы его ни запускали.
# Значения отсюда перекрывают одноимённые настройки в config.json.
# Ключи - от СУБАККАУНТА Bybit, только с правом торговли на споте, без вывода средств.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Необязательно: уведомления в Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно: режим (paper / testnet / live) вместо "mode" из config.json
# BOT_MODE=paper
